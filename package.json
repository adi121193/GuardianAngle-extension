{
  "name": "pii-guardian",
  "version": "1.3.0",
  "description": "Local AI Privacy Browser Extension",
  "scripts": {
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest tests/unit",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest tests/integration",
    "test:regression": "NODE_OPTIONS=--experimental-vm-modules jest tests/regression",
    "build": "npm run test && node esbuild.config.js",
    "build:quick": "node esbuild.config.js",
    "build:free": "EXTENSION_TIER=free node esbuild.config.js && cp manifest.free.json dist/manifest.json",
    "build:pro": "EXTENSION_TIER=pro node esbuild.config.js && bash scripts/optimize-models.sh && cp manifest.pro.json dist/manifest.json",
    "package:free": "npm run build:free && cd dist && zip -r ../guardian-angle-free.zip . -x '*/models/*' -x '*/ml/*' -x '*/ocr/*'",
    "package:pro": "npm run build:pro && cd dist && zip -r ../guardian-angle-pro.zip .",
    "watch": "node esbuild.config.js --watch",
    "watch:free": "EXTENSION_TIER=free node esbuild.config.js --watch",
    "watch:pro": "EXTENSION_TIER=pro node esbuild.config.js --watch",
    "clean": "rm -rf dist coverage *.zip",
    "generate-icons": "node scripts/generate-icons.js",
    "precommit": "npm run test:regression && npm run test && npm run build:quick"
  },
  "type": "module",
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "onnxruntime-web": "^1.23.2",
    "tesseract.js": "^5.1.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@testing-library/jest-dom": "^6.9.1",
    "canvas": "^3.2.0",
    "esbuild": "^0.26.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "jsdom": "^27.3.0"
  },
  "keywords": [
    "privacy",
    "pii",
    "browser-extension",
    "chrome-extension"
  ],
  "license": "MIT"
}