{
  "name": "pii-guardian",
  "version": "1.3.0",
  "description": "Local AI Privacy Browser Extension",
  "scripts": {
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest tests/unit",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest tests/integration",
    "test:regression": "NODE_OPTIONS=--experimental-vm-modules jest tests/regression",
    "build": "npm run test && node esbuild.config.js",
    "build:quick": "node esbuild.config.js",
    "watch": "node esbuild.config.js --watch",
    "clean": "rm -rf dist coverage",
    "generate-icons": "node scripts/generate-icons.js",
    "precommit": "npm run test:regression && npm run test && npm run build:quick"
  },
  "type": "module",
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "onnxruntime-web": "^1.23.2"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@testing-library/jest-dom": "^6.9.1",
    "canvas": "^3.2.0",
    "esbuild": "^0.26.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "jsdom": "^27.3.0"
  },
  "keywords": [
    "privacy",
    "pii",
    "browser-extension",
    "chrome-extension"
  ],
  "license": "MIT"
}
